# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://lite:lite@postgres:5432/litescheduler

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Stripe (replace with real values before going live) ───────────────────────
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER
STRIPE_PRICE_ID=price_PLACEHOLDER
STRIPE_SUCCESS_URL=http://localhost:5173/?payment=success
STRIPE_CANCEL_URL=http://localhost:5173/pricing?payment=cancelled

# ── Timefold ──────────────────────────────────────────────────────────────────
SOLVER_TIMEOUT_SECONDS=30

# ── Meta (WhatsApp Business) bot ─────────────────────────────────────────────
# 1. Create a Meta Developer app at https://developers.facebook.com
# 2. Add the WhatsApp product to your app
# 3. Copy the Phone Number ID from WhatsApp → API Setup
META_PHONE_NUMBER_ID=1234567890
# 4. Generate a permanent system user token (or use the temporary token for dev)
META_ACCESS_TOKEN=EAAxxxxxxxxxxxx
# 5. Choose any string — enter the same value in the Meta webhook config UI
META_WEBHOOK_VERIFY_TOKEN=my_secure_verify_token
# 6. App Secret from Meta Developer Console → App Settings → Basic
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Set to "true" to skip signature validation during local dev / ngrok testing
META_SKIP_SIGNATURE=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list — add your CloudFront URL when deploying
ALLOWED_ORIGINS=http://localhost:5173,https://YOUR_CLOUDFRONT_DOMAIN.cloudfront.net
