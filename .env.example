# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://lite:lite@postgres:5432/litescheduler

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Stripe (replace with real values before going live) ───────────────────────
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER
STRIPE_PRICE_ID=price_PLACEHOLDER
STRIPE_SUCCESS_URL=http://localhost:5173/?payment=success
STRIPE_CANCEL_URL=http://localhost:5173/pricing?payment=cancelled

# ── Timefold ──────────────────────────────────────────────────────────────────
SOLVER_TIMEOUT_SECONDS=30

# ── Twilio WhatsApp bot ───────────────────────────────────────────────────────
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SKIP_SIGNATURE=false   # set to true for local dev / ngrok testing

# Content template SIDs — create in Twilio Console → Content Editor → Approve
# Each template needs 3 quick-reply buttons; body text shown in comments below.
# easca_main_menu:  "Hi {{1}}! What would you like to do?"  [Fichar][Schedule][More]
TWILIO_TMPL_MAIN_MENU=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# easca_fichar_menu: "Clock in/out or take a break?"  [Clock In][Clock Out][Break]
TWILIO_TMPL_FICHAR_MENU=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# easca_break_menu:  "Break action?"  [Start Break][End Break][Back]
TWILIO_TMPL_BREAK_MENU=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# easca_more_menu:   "More options:"  [Hours][Availability][Back]
TWILIO_TMPL_MORE_MENU=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# easca_hours_menu:  "Which period?"  [This Week][This Month][Back]
TWILIO_TMPL_HOURS_MENU=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list — add your CloudFront URL when deploying
ALLOWED_ORIGINS=http://localhost:5173,https://YOUR_CLOUDFRONT_DOMAIN.cloudfront.net
